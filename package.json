{
  "name": "procurement-portal",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:notification-service": "node services/notification-service/index.js",
    "start:ai-service": "node services/ai-service/index.js",
    "start:client": "npm --prefix client start",
    "build:client": "npm --prefix client run build",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:load": "node prisma/seed-load.js",
    "db:load:clean": "node prisma/seed-load.js --clean",
    "bench": "node scripts/bench.js",
    "explain": "node scripts/explain.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/client/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
