generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  APPROVER
  PROCUREMENT
  ADMIN
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum Decision {
  APPROVED
  REJECTED
}

enum POStatus {
  ISSUED
  CANCELLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Every model except Tenant, PRItem and Approval carries tenantId; PRItem and Approval
// are reached only through their PurchaseRequest. Isolation is enforced in src/db/prisma.js.
model Tenant {
  id            Int               @id @default(autoincrement())
  name          String
  slug          String            @unique
  status        TenantStatus      @default(ACTIVE)
  createdAt     DateTime          @default(now())
  users         User[]
  vendors       Vendor[]
  requests      PurchaseRequest[]
  orders        PurchaseOrder[]
  auditOutbox   AuditOutbox[]
  eventOutbox   EventOutbox[]
  notifications Notification[]
  webhookUrl    String?
  webhookSecret String?
}

model User {
  id            Int               @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  name          String
  email         String
  passwordHash  String
  role          Role              @default(REQUESTER)
  createdAt     DateTime          @default(now())
  requests      PurchaseRequest[]
  approvals     Approval[]
  auditOutbox   AuditOutbox[]
  notifications Notification[]

  @@unique([tenantId, email])
}

model Vendor {
  id        Int             @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  status    VendorStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]

  @@index([tenantId, status])
}

model PurchaseRequest {
  id            Int            @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  requesterId   Int
  requester     User           @relation(fields: [requesterId], references: [id])
  title         String
  justification String?
  status        PRStatus       @default(DRAFT)
  totalAmount   Decimal        @default(0) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PRItem[]
  approval      Approval?
  order         PurchaseOrder?

  // Lists are ordered newest-first by id and paged by cursor (id < cursor), so every index ends in id.
  @@index([tenantId, id])
  @@index([tenantId, status, id])
  @@index([tenantId, requesterId, id])
}

model PRItem {
  id          Int             @id @default(autoincrement())
  prId        Int
  pr          PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)

  // Postgres does not index foreign keys: without this every request load scanned the whole table.
  @@index([prId])
}

model Approval {
  id         Int             @id @default(autoincrement())
  prId       Int             @unique // one final decision per request (BR5)
  pr         PurchaseRequest @relation(fields: [prId], references: [id])
  approverId Int
  approver   User            @relation(fields: [approverId], references: [id])
  decision   Decision
  comment    String?
  decidedAt  DateTime        @default(now())
}

model PurchaseOrder {
  id       Int             @id @default(autoincrement())
  tenantId Int
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  prId     Int             @unique
  pr       PurchaseRequest @relation(fields: [prId], references: [id])
  vendorId Int
  vendor   Vendor          @relation(fields: [vendorId], references: [id])
  poNumber String
  status   POStatus        @default(ISSUED)
  issuedAt DateTime        @default(now())

  @@unique([tenantId, poNumber]) // BR7: sequential per tenant per year
  @@index([tenantId, id])
  @@index([tenantId, status, id])
}

// Transactional outbox for audit events. A row is written in the same transaction as the change it
// describes, then moved to MongoDB (the audit store) and deleted. Rows that stay here are events
// MongoDB has not accepted yet. See src/modules/audit/.
model AuditOutbox {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  actorId       Int?
  actor         User?    @relation(fields: [actorId], references: [id])
  action        String
  entity        String
  entityId      Int
  before        Json?
  after         Json?
  correlationId String?
  at            DateTime @default(now())
  attempts      Int      @default(0)
  lastError     String?

  @@index([tenantId, id])
}

// Domain events waiting to be published to the job queue. Written in the same transaction as the change
// that caused them, then relayed to BullMQ and deleted. Rows that stay here are events Redis has not accepted.
model EventOutbox {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  type          String
  payload       Json
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([tenantId, id])
}

// In-app notification. The unique key makes delivery idempotent: a job that runs twice (retry, crash
// recovery) cannot create a second notification for the same event and user.
model Notification {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  eventId   Int
  type      String
  title     String
  entity    String
  entityId  Int
  emailedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, eventId, type])
  @@index([tenantId, userId, id])
}
